---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = "/personal-site/";
---

<BaseLayout title="Matt · 个人主页">
  <section style="padding:20px 0 60px;position:relative;">
    <div class="hero-num" style="position:absolute;top:-40px;right:0;">01</div>
    <p style="font-family:var(--serif);font-size:14px;color:var(--accent);letter-spacing:0.08em;margin-bottom:16px;text-transform:uppercase;">Personal Site</p>
    <h1 style="font-family:var(--serif);font-size:48px;font-weight:900;line-height:1.15;letter-spacing:-0.01em;margin-bottom:20px;">
      营销人 ×<br/>内容创作者
    </h1>
    <p style="font-size:17px;color:var(--text-muted);max-width:520px;line-height:1.9;">
      4 年欧莱雅集团电商经验，专注推广策略与零售运营。擅长用 AI 工具重构工作流，把重复劳动变成自动化。
    </p>
  </section>

  <hr class="section-rule" />

  <section>
    <p style="font-family:var(--serif);font-size:13px;color:var(--accent);letter-spacing:0.08em;margin-bottom:12px;">能力标签</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:48px;">
      <span class="tag">天猫推广</span>
      <span class="tag">抖音运营</span>
      <span class="tag">内容创作</span>
      <span class="tag">跨境电商</span>
      <span class="tag">AI 提效</span>
    </div>
  </section>

  <section style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;">
    <a href={`${base}about`} style="text-decoration:none;color:inherit;">
      <div class="card">
        <p style="font-family:var(--serif);font-size:11px;color:var(--accent);letter-spacing:0.08em;margin-bottom:8px;">→ 关于</p>
        <h3 style="font-size:22px;">职业经历</h3>
        <p>理肤泉 · 碧欧泉 · 淘客拓展 · 从推广到零售全链路</p>
      </div>
    </a>
    <a href={`${base}portfolio`} style="text-decoration:none;color:inherit;">
      <div class="card">
        <p style="font-family:var(--serif);font-size:11px;color:var(--accent);letter-spacing:0.08em;margin-bottom:8px;">→ 作品</p>
        <h3 style="font-size:22px;">作品与项目</h3>
        <p>内容案例、电商项目与 AI 自动化工具</p>
      </div>
    </a>
    <a href={`${base}bookmarks`} style="text-decoration:none;color:inherit;">
      <div class="card">
        <p style="font-family:var(--serif);font-size:11px;color:var(--accent);letter-spacing:0.08em;margin-bottom:8px;">→ 收藏</p>
        <h3 style="font-size:22px;">资料收藏</h3>
        <p>行业报告、工具清单、好文存档</p>
      </div>
    </a>
    <a href={`${base}blog`} style="text-decoration:none;color:inherit;">
      <div class="card">
        <p style="font-family:var(--serif);font-size:11px;color:var(--accent);letter-spacing:0.08em;margin-bottom:8px;">→ 日志</p>
        <h3 style="font-size:22px;">思考记录</h3>
        <p>复盘、观察与日常想法</p>
      </div>
    </a>
  </section>
</BaseLayout>
