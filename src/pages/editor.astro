---
const base = "/personal-site/";
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>编辑 · Matt</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      background: #faf7f2; color: #1a1815;
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
    }
    .login-wrap { text-align: center; max-width: 380px; width: 100%; padding: 0 24px; }
    .login-wrap h1 { font-family: 'Noto Serif SC', 'STSong', serif; font-size: 28px; font-weight: 700; margin-bottom: 6px; }
    .login-wrap .sub { color: #8c8279; font-size: 14px; margin-bottom: 28px; }
    .login-wrap input { width: 100%; padding: 14px 18px; border: 1px solid #e8e2d9; font-size: 16px; text-align: center; letter-spacing: 0.2em; background: #fffefb; outline: none; transition: border-color .2s; }
    .login-wrap input:focus { border-color: #d4773d; }
    .login-wrap .err { color: #d4773d; font-size: 13px; margin-top: 10px; display:none; }
    .editor-wrap { display:none; width:100%; max-width:800px; padding:40px 24px; }
    .editor-wrap .topbar { display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px; padding-bottom: 16px; border-bottom:1px solid #e8e2d9; }
    .editor-wrap .topbar h2 { font-family: 'Noto Serif SC', 'STSong', serif; font-size: 20px; }
    .topbar button { background: none; border: 1px solid #e8e2d9; padding: 6px 16px; font-size: 13px; cursor: pointer; color: #8c8279; transition: .2s; }
    .topbar button:hover { border-color: #d4773d; color: #d4773d; }
    .field { margin-bottom: 16px; }
    .field label { display: block; font-size: 12px; color: #8c8279; letter-spacing: 0.06em; margin-bottom: 6px; text-transform: uppercase; }
    .field input, .field textarea { width: 100%; padding: 12px 16px; border: 1px solid #e8e2d9; font-size: 15px; background: #fffefb; outline: none; line-height: 1.6; }
    .field input:focus, .field textarea:focus { border-color: #d4773d; }
    .field textarea { min-height: 320px; resize: vertical; font-family: inherit; }
    .preview-box { display:none; padding: 24px; border: 1px solid #e8e2d9; min-height: 200px; line-height: 1.8; background: #fffefb; margin-bottom: 16px; }
    .actions { display:flex; gap:10px; margin-top: 20px; }
    .btn { padding: 10px 24px; border: none; font-size: 14px; cursor: pointer; letter-spacing: 0.04em; transition: .2s; }
    .btn-primary { background: #d4773d; color: #fff; }
    .btn-primary:hover { background: #c06830; }
    .btn-ghost { background: none; border: 1px solid #e8e2d9; color: #8c8279; }
    .btn-ghost:hover { border-color: #d4773d; color: #d4773d; }
    .status { font-size:13px; margin-top:12px; min-height:20px; }
    .status.ok { color:#059669; } .status.err { color:#d4773d; } .status.info { color:#8c8279; }
    .token-setup { display:none; margin-bottom:20px; padding:16px; border:1px solid #e8e2d9; background:#fffefb; }
    .token-setup p { font-size:13px; color:#8c8279; line-height:1.8; margin-bottom:10px; }
    .token-setup a { color:#d4773d; }
  </style>
</head>
<body>

<div class="login-wrap" id="loginScreen">
  <h1>编辑入口</h1>
  <p class="sub">输入密码以继续</p>
  <input type="password" id="pwdInput" placeholder="······" autofocus />
  <p class="err" id="loginErr">密码错误</p>
</div>

<div class="editor-wrap" id="editorScreen">
  <div class="token-setup" id="tokenSetup">
    <p><strong>首次使用需要 GitHub Token</strong></p>
    <p>1. 打开 <a href="https://github.com/settings/tokens/new?scopes=repo&description=blog-editor" target="_blank">GitHub Token 创建页</a>（已自动勾选 repo 权限）</p>
    <p>2. 拉到页面底部点「Generate token」</p>
    <p>3. 复制生成的 token，粘贴到下方：</p>
    <input type="text" id="tokenInput" placeholder="ghp_xxxxxxxxxxxx" style="width:100%;padding:8px 12px;font-size:14px;border:1px solid #e8e2d9;margin-top:8px;" />
    <button class="btn btn-primary" style="margin-top:10px;" id="saveTokenBtn">保存 Token</button>
    <p class="status" id="tokenStatus"></p>
  </div>

  <div class="topbar">
    <h2>写日志</h2>
    <div>
      <button id="previewBtn">预览</button>
      <button id="logoutBtn" style="margin-left:8px;">退出</button>
    </div>
  </div>

  <div class="field">
    <label>标题</label>
    <input type="text" id="titleInput" placeholder="文章标题..." />
  </div>

  <div class="field" id="bodyField">
    <label>正文（Markdown）</label>
    <textarea id="bodyInput" placeholder="开始写作...&#10;&#10;支持 Markdown 格式"></textarea>
  </div>

  <div class="preview-box" id="previewBox"></div>

  <div class="actions">
    <button class="btn btn-primary" id="publishBtn">发布</button>
    <button class="btn btn-ghost" id="saveDraftBtn">保存草稿</button>
  </div>
  <p class="status" id="statusMsg"></p>
</div>

<script is:inline>
(function() {
  var PASS_HASH = '50062a8a3f5b30879142c2f46b6e31839f8311a216206a7de6f8a2d7c6ed4bb2';
  var OWNER = 'yihongma5';
  var REPO = 'personal-site';
  var previewOn = false;

  function sha256(msg, cb) {
    crypto.subtle.digest('SHA-256', new TextEncoder().encode(msg)).then(function(buf) {
      cb(Array.from(new Uint8Array(buf)).map(function(b) { return b.toString(16).padStart(2,'0'); }).join(''));
    });
  }

  // Login
  document.getElementById('pwdInput').addEventListener('keydown', function(e) {
    if (e.key !== 'Enter') return;
    var self = this;
    sha256(self.value, function(hash) {
      if (hash === PASS_HASH) {
        document.getElementById('loginScreen').style.display = 'none';
        document.getElementById('editorScreen').style.display = 'block';
        loadDraft();
        if (!localStorage.getItem('gh_token')) {
          document.getElementById('tokenSetup').style.display = 'block';
        }
      } else {
        document.getElementById('loginErr').style.display = 'block';
        self.value = '';
      }
    });
  });

  // Token
  document.getElementById('saveTokenBtn').addEventListener('click', function() {
    var t = document.getElementById('tokenInput').value.trim();
    if (!t) return;
    localStorage.setItem('gh_token', t);
    document.getElementById('tokenSetup').style.display = 'none';
    setStatus('Token 已保存，可以开始发布了', 'ok');
  });

  // Draft
  function saveDraft() {
    var draft = { title: document.getElementById('titleInput').value, body: document.getElementById('bodyInput').value, savedAt: new Date().toISOString() };
    localStorage.setItem('blog_draft', JSON.stringify(draft));
    setStatus('草稿已保存', 'ok');
  }
  function loadDraft() {
    var raw = localStorage.getItem('blog_draft');
    if (!raw) return;
    try { var d = JSON.parse(raw); if (d.title) document.getElementById('titleInput').value = d.title; if (d.body) document.getElementById('bodyInput').value = d.body; } catch(e) {}
  }
  document.getElementById('saveDraftBtn').addEventListener('click', saveDraft);
  setInterval(function() {
    var t = document.getElementById('titleInput').value, b = document.getElementById('bodyInput').value;
    if (t || b) localStorage.setItem('blog_draft', JSON.stringify({title:t, body:b, savedAt:new Date().toISOString()}));
  }, 10000);

  // Preview
  document.getElementById('previewBtn').addEventListener('click', function() {
    previewOn = !previewOn;
    var body = document.getElementById('bodyField');
    var preview = document.getElementById('previewBox');
    if (previewOn) {
      body.style.display = 'none'; preview.style.display = 'block';
      var md = document.getElementById('bodyInput').value;
      preview.innerHTML = md.replace(/^### (.+)$/gm,'<h3>$1</h3>').replace(/^## (.+)$/gm,'<h2>$1</h2>').replace(/^# (.+)$/gm,'<h1>$1</h1>').replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/\*(.+?)\*/g,'<em>$1</em>').replace(/^\- (.+)$/gm,'<li>$1</li>').replace(/\n\n/g,'</p><p>').replace(/^(?!<[hpl])/gm,'<p>') + '</p>';
      this.textContent = '编辑';
    } else {
      body.style.display = ''; preview.style.display = 'none';
      this.textContent = '预览';
    }
  });

  // Logout
  document.getElementById('logoutBtn').addEventListener('click', function() { location.reload(); });

  // Publish
  document.getElementById('publishBtn').addEventListener('click', function() {
    var title = document.getElementById('titleInput').value.trim();
    var bodyText = document.getElementById('bodyInput').value.trim();
    if (!title || !bodyText) { setStatus('标题和正文不能为空', 'err'); return; }
    var token = localStorage.getItem('gh_token');
    if (!token) { setStatus('请先设置 GitHub Token', 'err'); document.getElementById('tokenSetup').style.display='block'; return; }

    var btn = this;
    btn.disabled = true; btn.textContent = '发布中...';
    setStatus('正在发布...', 'info');

    var now = new Date();
    var dateStr = now.toISOString().split('T')[0];
    var timeStr = now.toLocaleString('zh-CN', { hour12: false });
    var slug = dateStr + '-' + title.replace(/[^\w一-鿿]/g, '-').replace(/-+/g,'-').replace(/^-|-$/g,'').substring(0,40).toLowerCase();
    var frontmatter = '---\ntitle: "' + title + '"\ndate: "' + dateStr + '"\ndesc: "' + bodyText.replace(/[#*\n]/g,' ').substring(0,80) + '"\n---\n\n> 发布于 ' + timeStr + '\n\n' + bodyText;
    var path = 'src/content/blog/' + slug + '.md';

    fetch('https://api.github.com/repos/' + OWNER + '/' + REPO + '/git/refs/heads/main', {
      headers: { Authorization: 'token ' + token }
    }).then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function(main) {
      return fetch('https://api.github.com/repos/' + OWNER + '/' + REPO + '/git/blobs', {
        method: 'POST', headers: { Authorization: 'token ' + token, 'Content-Type':'application/json' },
        body: JSON.stringify({ content: btoa(unescape(encodeURIComponent(frontmatter))), encoding:'base64' })
      }).then(function(r) { return r.json(); }).then(function(blob) {
        return fetch('https://api.github.com/repos/' + OWNER + '/' + REPO + '/git/trees', {
          method: 'POST', headers: { Authorization: 'token ' + token, 'Content-Type':'application/json' },
          body: JSON.stringify({ base_tree: main.object.sha, tree:[{ path:path, mode:'100644', type:'blob', sha:blob.sha }] })
        }).then(function(r) { return r.json(); }).then(function(tree) {
          return fetch('https://api.github.com/repos/' + OWNER + '/' + REPO + '/git/commits', {
            method: 'POST', headers: { Authorization: 'token ' + token, 'Content-Type':'application/json' },
            body: JSON.stringify({ message:'blog: ' + title, tree:tree.sha, parents:[main.object.sha] })
          }).then(function(r) { return r.json(); }).then(function(commit) {
            return fetch('https://api.github.com/repos/' + OWNER + '/' + REPO + '/git/refs/heads/main', {
              method: 'PATCH', headers: { Authorization: 'token ' + token, 'Content-Type':'application/json' },
              body: JSON.stringify({ sha:commit.sha, force:false })
            });
          });
        });
      });
    }).then(function() {
      setStatus('已发布！约 1 分钟后在日志页可见', 'ok');
      localStorage.removeItem('blog_draft');
      document.getElementById('titleInput').value = '';
      document.getElementById('bodyInput').value = '';
      btn.disabled = false; btn.textContent = '发布';
    }).catch(function(e) {
      setStatus('发布失败: ' + e.message, 'err');
      btn.disabled = false; btn.textContent = '发布';
    });
  });

  function setStatus(msg, cls) {
    var el = document.getElementById('statusMsg');
    el.textContent = msg;
    el.className = 'status ' + (cls || '');
  }
})();
</script>
</body>
</html>
