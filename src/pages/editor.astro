---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>编辑 · Matt</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      background: #faf7f2; color: #1a1815;
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
    }
    .login-wrap { text-align: center; max-width: 380px; width: 100%; padding: 0 24px; }
    .login-wrap h1 { font-family: 'Noto Serif SC', 'STSong', serif; font-size: 28px; font-weight: 700; margin-bottom: 6px; }
    .login-wrap .sub { color: #8c8279; font-size: 14px; margin-bottom: 28px; }
    .login-wrap input { width: 100%; padding: 14px 18px; border: 1px solid #e8e2d9; font-size: 16px; text-align: center; letter-spacing: 0.2em; background: #fffefb; outline: none; transition: border-color .2s; }
    .login-wrap input:focus { border-color: #d4773d; }
    .login-wrap .err { color: #d4773d; font-size: 13px; margin-top: 10px; display:none; }
    .editor-wrap { display:none; width:100%; max-width:800px; padding:40px 24px; }
    .editor-wrap .topbar { display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px; padding-bottom: 16px; border-bottom:1px solid #e8e2d9; }
    .editor-wrap .topbar h2 { font-family: 'Noto Serif SC', 'STSong', serif; font-size: 20px; }
    .topbar button { background: none; border: 1px solid #e8e2d9; padding: 6px 16px; font-size: 13px; cursor: pointer; color: #8c8279; transition: .2s; }
    .topbar button:hover { border-color: #d4773d; color: #d4773d; }
    .field { margin-bottom: 16px; }
    .field label { display: block; font-size: 12px; color: #8c8279; letter-spacing: 0.06em; margin-bottom: 6px; text-transform: uppercase; }
    .field input, .field textarea { width: 100%; padding: 12px 16px; border: 1px solid #e8e2d9; font-size: 15px; background: #fffefb; outline: none; line-height: 1.6; }
    .field input:focus, .field textarea:focus { border-color: #d4773d; }
    .field textarea { min-height: 320px; resize: vertical; font-family: inherit; }
    .preview-box { display:none; padding: 24px; border: 1px solid #e8e2d9; min-height: 200px; line-height: 1.8; background: #fffefb; margin-bottom: 16px; }
    .actions { display:flex; gap:10px; margin-top: 20px; }
    .btn { padding: 10px 24px; border: none; font-size: 14px; cursor: pointer; letter-spacing: 0.04em; transition: .2s; }
    .btn-primary { background: #d4773d; color: #fff; }
    .btn-primary:hover { background: #c06830; }
    .btn-ghost { background: none; border: 1px solid #e8e2d9; color: #8c8279; }
    .btn-ghost:hover { border-color: #d4773d; color: #d4773d; }
    .btn-sm { font-size:11px; padding:3px 9px; background:none; border:1px solid #e8e2d9; cursor:pointer; transition:.2s; }
    .btn-sm.btn-del { color:#c44; border-color:#e8d2d9; }
    .btn-sm.btn-del:hover { background:#fef5f5; border-color:#c44; }
    .btn-sm.btn-hide { color:#8c8279; }
    .btn-sm.btn-hide:hover { border-color:#8c8279; }
    .btn-sm.btn-hide.hidden-post { color:#059669; border-color:#b7e4d4; background:#f0faf5; }
    .status { font-size:13px; margin-top:12px; min-height:20px; }
    .status.ok { color:#059669; } .status.err { color:#d4773d; } .status.info { color:#8c8279; }
    .token-setup { display:none; margin-bottom:20px; padding:16px; border:1px solid #e8e2d9; background:#fffefb; }
    .token-setup p { font-size:13px; color:#8c8279; line-height:1.8; margin-bottom:10px; }
    .token-setup a { color:#d4773d; }

    .post-list-wrap { margin-top:40px; padding-top:24px; border-top:1px solid #e8e2d9; }
    .post-list-wrap h3 { font-family: 'Noto Serif SC','STSong',serif; font-size:16px; margin-bottom:14px; }
    .post-item { display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid #f0e8db; font-size:14px; }
    .post-item .post-info { flex:1; min-width:0; }
    .post-item .post-title { color:#1a1815; font-weight:500; }
    .post-item .post-date { color:#8c8279; font-size:12px; display:block; margin-top:2px; }
    .post-item .post-hidden { color:#059669; font-size:11px; margin-left:6px; }
    .post-item .post-actions { display:flex; gap:6px; align-items:center; flex-shrink:0; margin-left:12px; }
  </style>
</head>
<body>

<div class="login-wrap" id="loginScreen">
  <h1>编辑入口</h1>
  <p class="sub">输入密码以继续</p>
  <input type="password" id="pwdInput" placeholder="······" autofocus />
  <p class="err" id="loginErr">密码错误</p>
</div>

<div class="editor-wrap" id="editorScreen">
  <div class="token-setup" id="tokenSetup">
    <p><strong>首次使用需要 GitHub Token</strong></p>
    <p>1. 打开 <a href="https://github.com/settings/tokens/new?scopes=repo&description=blog-editor" target="_blank">GitHub Token 创建页</a></p>
    <p>2. 拉到页面底部点「Generate token」，复制 token 粘贴到下方：</p>
    <input type="text" id="tokenInput" placeholder="ghp_xxxxxxxxxxxx" style="width:100%;padding:8px 12px;font-size:14px;border:1px solid #e8e2d9;margin-top:8px;" />
    <button class="btn btn-primary" style="margin-top:10px;" id="saveTokenBtn">保存 Token</button>
    <p class="status" id="tokenStatus"></p>
  </div>

  <div class="topbar">
    <h2>写日志</h2>
    <div>
      <button id="previewBtn">预览</button>
      <button id="logoutBtn" style="margin-left:8px;">退出</button>
    </div>
  </div>

  <div class="field">
    <label>标题</label>
    <input type="text" id="titleInput" placeholder="文章标题..." />
  </div>

  <div class="field" id="bodyField">
    <label>正文（Markdown）</label>
    <textarea id="bodyInput" placeholder="开始写作...&#10;&#10;支持 Markdown 格式"></textarea>
  </div>

  <div class="preview-box" id="previewBox"></div>

  <div class="actions">
    <button class="btn btn-primary" id="publishBtn">发布</button>
    <button class="btn btn-ghost" id="saveDraftBtn">保存草稿</button>
  </div>
  <p class="status" id="statusMsg"></p>

  <div class="post-list-wrap">
    <h3>已发布日志</h3>
    <p class="status" id="listStatus"></p>
    <div id="postList"></div>
  </div>
</div>

<script is:inline>
(function() {
  var PASS_HASH = '50062a8a3f5b30879142c2f46b6e31839f8311a216206a7de6f8a2d7c6ed4bb2';
  var OWNER = 'yihongma5';
  var REPO = 'personal-site';
  var previewOn = false;

  function api(path, opts) {
    var token = localStorage.getItem('gh_token');
    if (!token) return Promise.reject(new Error('未设置Token'));
    var headers = { Authorization: 'token ' + token };
    if (opts && opts.body) headers['Content-Type'] = 'application/json';
    return fetch('https://api.github.com/repos/' + OWNER + '/' + REPO + '/' + path, Object.assign({ headers: headers }, opts || {}));
  }

  function sha256(msg, cb) {
    crypto.subtle.digest('SHA-256', new TextEncoder().encode(msg)).then(function(buf) {
      cb(Array.from(new Uint8Array(buf)).map(function(b) { return b.toString(16).padStart(2,'0'); }).join(''));
    });
  }

  // Login
  document.getElementById('pwdInput').addEventListener('keydown', function(e) {
    if (e.key !== 'Enter') return;
    var self = this;
    sha256(self.value, function(hash) {
      if (hash === PASS_HASH) {
        document.getElementById('loginScreen').style.display = 'none';
        document.getElementById('editorScreen').style.display = 'block';
        loadDraft();
        loadPostList();
        if (!localStorage.getItem('gh_token')) {
          document.getElementById('tokenSetup').style.display = 'block';
        }
      } else {
        document.getElementById('loginErr').style.display = 'block';
        self.value = '';
      }
    });
  });

  // Token
  document.getElementById('saveTokenBtn').addEventListener('click', function() {
    var t = document.getElementById('tokenInput').value.trim();
    if (!t) return;
    localStorage.setItem('gh_token', t);
    document.getElementById('tokenSetup').style.display = 'none';
    document.getElementById('tokenStatus').textContent = 'Token 已保存';
    document.getElementById('tokenStatus').className = 'status ok';
  });

  // Draft
  document.getElementById('saveDraftBtn').addEventListener('click', function() {
    var draft = { title: document.getElementById('titleInput').value, body: document.getElementById('bodyInput').value, savedAt: new Date().toISOString() };
    localStorage.setItem('blog_draft', JSON.stringify(draft));
    document.getElementById('statusMsg').textContent = '草稿已保存';
    document.getElementById('statusMsg').className = 'status ok';
  });
  function loadDraft() {
    var raw = localStorage.getItem('blog_draft');
    if (!raw) return;
    try { var d = JSON.parse(raw); if (d.title) document.getElementById('titleInput').value = d.title; if (d.body) document.getElementById('bodyInput').value = d.body; } catch(e) {}
  }
  setInterval(function() {
    var t = document.getElementById('titleInput').value, b = document.getElementById('bodyInput').value;
    if (t || b) localStorage.setItem('blog_draft', JSON.stringify({title:t, body:b, savedAt:new Date().toISOString()}));
  }, 10000);

  // Preview
  document.getElementById('previewBtn').addEventListener('click', function() {
    previewOn = !previewOn;
    var body = document.getElementById('bodyField');
    var preview = document.getElementById('previewBox');
    if (previewOn) {
      body.style.display = 'none'; preview.style.display = 'block';
      var md = document.getElementById('bodyInput').value;
      preview.innerHTML = md.replace(/^### (.+)$/gm,'<h3>$1</h3>').replace(/^## (.+)$/gm,'<h2>$1</h2>').replace(/^# (.+)$/gm,'<h1>$1</h1>').replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/\*(.+?)\*/g,'<em>$1</em>').replace(/^\- (.+)$/gm,'<li>$1</li>').replace(/\n\n/g,'</p><p>').replace(/^(?!<[hpl])/gm,'<p>') + '</p>';
      this.textContent = '编辑';
    } else {
      body.style.display = ''; preview.style.display = 'none';
      this.textContent = '预览';
    }
  });

  document.getElementById('logoutBtn').addEventListener('click', function() { location.reload(); });

  // Publish
  document.getElementById('publishBtn').addEventListener('click', function() {
    var title = document.getElementById('titleInput').value.trim();
    var bodyText = document.getElementById('bodyInput').value.trim();
    if (!title || !bodyText) { document.getElementById('statusMsg').textContent = '标题和正文不能为空'; document.getElementById('statusMsg').className = 'status err'; return; }
    if (!localStorage.getItem('gh_token')) { document.getElementById('statusMsg').textContent = '请先设置GitHub Token'; document.getElementById('statusMsg').className = 'status err'; document.getElementById('tokenSetup').style.display='block'; return; }

    var btn = this;
    btn.disabled = true; btn.textContent = '发布中...';
    document.getElementById('statusMsg').textContent = '正在发布...'; document.getElementById('statusMsg').className = 'status info';

    var now = new Date();
    var dateStr = now.toISOString().split('T')[0];
    var timeStr = now.toLocaleString('zh-CN', { hour12: false });
    var slug = dateStr + '-' + title.replace(/[^\w一-鿿]/g, '-').replace(/-+/g,'-').replace(/^-|-$/g,'').substring(0,40).toLowerCase();
    var path = 'src/content/blog/' + slug + '.md';
    var frontmatter = '---\ntitle: "' + title + '"\ndate: "' + dateStr + '"\ndesc: "' + bodyText.replace(/[#*\n]/g,' ').substring(0,80) + '"\n---\n\n> 发布于 ' + timeStr + '\n\n' + bodyText;

    api('git/refs/heads/main').then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function(main) {
      return api('git/blobs', { method:'POST', body: JSON.stringify({ content: btoa(unescape(encodeURIComponent(frontmatter))), encoding:'base64' }) })
        .then(function(r) { return r.json(); }).then(function(blob) {
          return api('git/trees', { method:'POST', body: JSON.stringify({ base_tree: main.object.sha, tree:[{ path:path, mode:'100644', type:'blob', sha:blob.sha }] }) })
            .then(function(r) { return r.json(); }).then(function(tree) {
              return api('git/commits', { method:'POST', body: JSON.stringify({ message:'blog: ' + title, tree:tree.sha, parents:[main.object.sha] }) })
                .then(function(r) { return r.json(); }).then(function(commit) {
                  return api('git/refs/heads/main', { method:'PATCH', body: JSON.stringify({ sha:commit.sha, force:false }) });
                });
            });
        });
    }).then(function() {
      document.getElementById('statusMsg').textContent = '已发布！约 1 分钟后在日志页可见'; document.getElementById('statusMsg').className = 'status ok';
      localStorage.removeItem('blog_draft');
      document.getElementById('titleInput').value = '';
      document.getElementById('bodyInput').value = '';
      btn.disabled = false; btn.textContent = '发布';
      loadPostList();
    }).catch(function(e) {
      document.getElementById('statusMsg').textContent = '发布失败: ' + e.message; document.getElementById('statusMsg').className = 'status err';
      btn.disabled = false; btn.textContent = '发布';
    });
  });

  // ===== 已发布列表 =====
  function loadPostList() {
    var listEl = document.getElementById('postList');
    var statusEl = document.getElementById('listStatus');
    listEl.innerHTML = ''; statusEl.textContent = '加载中...'; statusEl.className = 'status info';

    api('contents/src/content/blog').then(function(r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    }).then(function(files) {
      statusEl.textContent = '';
      files.sort(function(a,b) { return a.name < b.name ? 1 : -1; });

      var pending = files.length;
      if (pending === 0) {
        listEl.innerHTML = '<p style="color:#8c8279;font-size:13px;">暂无已发布日志</p>';
        return;
      }

      files.forEach(function(f) {
        // 获取文件内容以解析 frontmatter
        api('contents/' + f.path).then(function(r) { return r.json(); }).then(function(data) {
          var content = decodeURIComponent(escape(atob(data.content.replace(/\s/g,''))));
          var titleMatch = content.match(/title:\s*"([^"]*)"/);
          var hiddenMatch = content.match(/hidden:\s*true/);
          var title = titleMatch ? titleMatch[1] : f.name.replace('.md','');
          var isHidden = !!hiddenMatch;

          var div = document.createElement('div');
          div.className = 'post-item';
          div.innerHTML = '<span class="post-info">'
            + '<span class="post-title">' + title + (isHidden ? '<span class="post-hidden">🔒 已隐藏</span>' : '') + '</span>'
            + '<span class="post-date">' + f.name.replace('.md','') + '</span>'
            + '</span>'
            + '<span class="post-actions">'
            + '<button class="btn-sm btn-hide' + (isHidden ? ' hidden-post' : '') + '" data-path="' + f.path + '" data-sha="' + data.sha + '" data-hidden="' + isHidden + '" data-content="' + encodeURIComponent(content) + '">' + (isHidden ? '显示' : '隐藏') + '</button>'
            + '<button class="btn-sm btn-del" data-path="' + f.path + '" data-sha="' + data.sha + '">删除</button>'
            + '</span>';
          listEl.appendChild(div);

          // 绑定按钮
          div.querySelector('.btn-del').addEventListener('click', function() {
            if (!confirm('确定删除「' + title + '」？ 此操作不可撤销。')) return;
            deletePost(this.getAttribute('data-path'), this);
          });
          div.querySelector('.btn-hide').addEventListener('click', function() {
            var path = this.getAttribute('data-path');
            var content = decodeURIComponent(this.getAttribute('data-content'));
            var hidden = this.getAttribute('data-hidden') === 'true';
            toggleHidden(path, content, hidden, this);
          });

          pending--;
        }).catch(function(e) {
          pending--;
          console.error('Failed to load', f.path, e);
        });
      });
    }).catch(function(e) {
      statusEl.textContent = '加载失败: ' + e.message;
      statusEl.className = 'status err';
    });
  }

  function deletePost(filePath, btnEl) {
    btnEl.disabled = true; btnEl.textContent = '删除中...';
    api('git/refs/heads/main').then(function(r) { return r.json(); }).then(function(main) {
      return api('git/trees', { method:'POST', body: JSON.stringify({
        base_tree: main.object.sha,
        tree: [{ path: filePath, mode:'100644', type:'blob', sha: null }]
      }) }).then(function(r) { return r.json(); }).then(function(tree) {
        return api('git/commits', { method:'POST', body: JSON.stringify({
          message: 'blog: 删除 ' + filePath.replace('src/content/blog/',''),
          tree: tree.sha, parents: [main.object.sha]
        }) }).then(function(r) { return r.json(); }).then(function(commit) {
          return api('git/refs/heads/main', { method:'PATCH', body: JSON.stringify({ sha:commit.sha, force:false }) });
        });
      });
    }).then(function() {
      loadPostList();
    }).catch(function(e) {
      alert('删除失败: ' + e.message);
      btnEl.disabled = false; btnEl.textContent = '删除';
    });
  }

  function toggleHidden(filePath, currentContent, currentlyHidden, btnEl) {
    btnEl.disabled = true; btnEl.textContent = '处理中...';

    var newContent;
    if (currentlyHidden) {
      newContent = currentContent.replace(/\nhidden:\s*true\n/, '\n');
    } else {
      newContent = currentContent.replace(/^---\n/, '---\nhidden: true\n');
    }

    api('git/refs/heads/main').then(function(r) { return r.json(); }).then(function(main) {
      return api('git/blobs', { method:'POST', body: JSON.stringify({ content: btoa(unescape(encodeURIComponent(newContent))), encoding:'base64' }) })
        .then(function(r) { return r.json(); }).then(function(blob) {
          return api('git/trees', { method:'POST', body: JSON.stringify({
            base_tree: main.object.sha,
            tree: [{ path: filePath, mode:'100644', type:'blob', sha: blob.sha }]
          }) }).then(function(r) { return r.json(); }).then(function(tree) {
            return api('git/commits', { method:'POST', body: JSON.stringify({
              message: 'blog: ' + (currentlyHidden ? '显示' : '隐藏') + ' ' + filePath.replace('src/content/blog/',''),
              tree: tree.sha, parents: [main.object.sha]
            }) }).then(function(r) { return r.json(); }).then(function(commit) {
              return api('git/refs/heads/main', { method:'PATCH', body: JSON.stringify({ sha:commit.sha, force:false }) });
            });
          });
        });
    }).then(function() {
      loadPostList();
    }).catch(function(e) {
      alert('操作失败: ' + e.message);
      btnEl.disabled = false;
    });
  }
})();
</script>
</body>
</html>
