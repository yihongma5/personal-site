---
const base = "/personal-site/";
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>编辑 · Matt</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      background: #faf7f2; color: #1a1815;
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
    }
    /* ===== 登录 ===== */
    .login-wrap {
      text-align: center; max-width: 380px; width: 100%; padding: 0 24px;
    }
    .login-wrap h1 {
      font-family: 'Noto Serif SC', 'STSong', serif; font-size: 28px;
      font-weight: 700; margin-bottom: 6px;
    }
    .login-wrap .sub { color: #8c8279; font-size: 14px; margin-bottom: 28px; }
    .login-wrap input {
      width: 100%; padding: 14px 18px; border: 1px solid #e8e2d9;
      font-size: 16px; text-align: center; letter-spacing: 0.2em;
      background: #fffefb; outline: none; transition: border-color .2s;
    }
    .login-wrap input:focus { border-color: #d4773d; }
    .login-wrap .err { color: #d4773d; font-size: 13px; margin-top: 10px; display:none; }
    /* ===== 编辑器 ===== */
    .editor-wrap { display:none; width:100%; max-width:800px; padding:40px 24px; }
    .editor-wrap .topbar {
      display:flex; justify-content:space-between; align-items:center;
      margin-bottom: 24px; padding-bottom: 16px; border-bottom:1px solid #e8e2d9;
    }
    .editor-wrap .topbar h2 {
      font-family: 'Noto Serif SC', 'STSong', serif; font-size: 20px;
    }
    .editor-wrap .topbar button {
      background: none; border: 1px solid #e8e2d9; padding: 6px 16px;
      font-size: 13px; cursor: pointer; color: #8c8279; transition: .2s;
    }
    .editor-wrap .topbar button:hover { border-color: #d4773d; color: #d4773d; }
    .field { margin-bottom: 16px; }
    .field label {
      display: block; font-size: 12px; color: #8c8279;
      letter-spacing: 0.06em; margin-bottom: 6px; text-transform: uppercase;
    }
    .field input, .field textarea {
      width: 100%; padding: 12px 16px; border: 1px solid #e8e2d9;
      font-size: 15px; background: #fffefb; outline: none; line-height: 1.6;
    }
    .field input:focus, .field textarea:focus { border-color: #d4773d; }
    .field textarea { min-height: 320px; resize: vertical; font-family: inherit; }
    .preview-box {
      display:none; padding: 24px; border: 1px solid #e8e2d9; min-height: 200px;
      line-height: 1.8; background: #fffefb; margin-bottom: 16px;
    }
    .preview-box h1,.preview-box h2 { font-family: 'Noto Serif SC','STSong',serif; margin:16px 0 8px; }
    .actions { display:flex; gap:10px; margin-top: 20px; }
    .btn {
      padding: 10px 24px; border: none; font-size: 14px; cursor: pointer;
      letter-spacing: 0.04em; transition: .2s;
    }
    .btn-primary { background: #d4773d; color: #fff; }
    .btn-primary:hover { background: #c06830; }
    .btn-ghost { background: none; border: 1px solid #e8e2d9; color: #8c8279; }
    .btn-ghost:hover { border-color: #d4773d; color: #d4773d; }
    .status { font-size:13px; margin-top:12px; }
    .status.ok { color:#059669; }
    .status.err { color:#d4773d; }
    /* token setup */
    .token-setup { display:none; margin-bottom:20px; padding:16px; border:1px solid #e8e2d9; background:#fffefb; }
    .token-setup p { font-size:13px; color:#8c8279; line-height:1.8; margin-bottom:10px; }
    .token-setup a { color:#d4773d; }
  </style>
</head>
<body>

<!-- ===== 登录 ===== -->
<div class="login-wrap" id="loginScreen">
  <h1>编辑入口</h1>
  <p class="sub">输入密码以继续</p>
  <input type="password" id="pwdInput" placeholder="······" autofocus />
  <p class="err" id="loginErr">密码错误</p>
</div>

<!-- ===== 编辑器 ===== -->
<div class="editor-wrap" id="editorScreen">
  <!-- Token 设置 -->
  <div class="token-setup" id="tokenSetup">
    <p><strong>首次使用需要 GitHub Token</strong></p>
    <p>1. 打开 <a href="https://github.com/settings/tokens/new?scopes=repo&description=blog-editor" target="_blank">GitHub Token 创建页</a></p>
    <p>2. 点击底部的「Generate token」，复制生成的 token</p>
    <p>3. 粘贴到下方：</p>
    <input type="text" id="tokenInput" placeholder="ghp_xxxxxxxxxxxx" style="width:100%;padding:8px 12px;font-size:14px;border:1px solid #e8e2d9;margin-top:8px;" />
    <button class="btn btn-primary" style="margin-top:10px;" onclick="saveToken()">保存 Token</button>
  </div>

  <div class="topbar">
    <h2>写日志</h2>
    <div>
      <button onclick="togglePreview()" id="previewBtn">预览</button>
      <button onclick="location.reload()" style="margin-left:8px;">退出</button>
    </div>
  </div>

  <div class="field">
    <label>标题</label>
    <input type="text" id="titleInput" placeholder="文章标题..." />
  </div>

  <div class="field" id="bodyField">
    <label>正文（Markdown）</label>
    <textarea id="bodyInput" placeholder="开始写作...&#10;&#10;支持 Markdown 格式"></textarea>
  </div>

  <div class="preview-box" id="previewBox"></div>

  <div class="actions">
    <button class="btn btn-primary" onclick="publish()">发布</button>
    <button class="btn btn-ghost" onclick="saveDraft()">保存草稿</button>
  </div>
  <p class="status" id="statusMsg"></p>
</div>

<script>
// 密码: SHA-256
const PASS_HASH = '5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8'; // "password"

// ===== 登录 =====
const pwdInput = document.getElementById('pwdInput');
pwdInput.addEventListener('keydown', async (e) => {
  if (e.key !== 'Enter') return;
  const hash = await sha256(pwdInput.value);
  if (hash === PASS_HASH) {
    document.getElementById('loginScreen').style.display = 'none';
    const editor = document.getElementById('editorScreen');
    editor.style.display = 'block';
    loadDraft();
    checkToken();
  } else {
    document.getElementById('loginErr').style.display = 'block';
    pwdInput.value = '';
  }
});

async function sha256(msg) {
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(msg));
  return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2,'0')).join('');
}

// ===== Token =====
function checkToken() {
  const token = localStorage.getItem('gh_token');
  if (!token) {
    document.getElementById('tokenSetup').style.display = 'block';
  }
}
function saveToken() {
  const token = document.getElementById('tokenInput').value.trim();
  if (!token) return;
  localStorage.setItem('gh_token', token);
  document.getElementById('tokenSetup').style.display = 'none';
  setStatus('Token 已保存', 'ok');
}

// ===== 草稿 =====
function saveDraft() {
  const draft = {
    title: document.getElementById('titleInput').value,
    body: document.getElementById('bodyInput').value,
    savedAt: new Date().toISOString()
  };
  localStorage.setItem('blog_draft', JSON.stringify(draft));
  setStatus('草稿已保存', 'ok');
}
function loadDraft() {
  const raw = localStorage.getItem('blog_draft');
  if (!raw) return;
  try {
    const draft = JSON.parse(raw);
    document.getElementById('titleInput').value = draft.title || '';
    document.getElementById('bodyInput').value = draft.body || '';
  } catch(e) {}
}
// 自动保存
setInterval(() => {
  const t = document.getElementById('titleInput').value;
  const b = document.getElementById('bodyInput').value;
  if (t || b) {
    localStorage.setItem('blog_draft', JSON.stringify({
      title: t, body: b, savedAt: new Date().toISOString()
    }));
  }
}, 10000);

// ===== 预览 =====
let previewOn = false;
function togglePreview() {
  previewOn = !previewOn;
  const body = document.getElementById('bodyField');
  const preview = document.getElementById('previewBox');
  const btn = document.getElementById('previewBtn');
  if (previewOn) {
    body.style.display = 'none';
    preview.style.display = 'block';
    preview.innerHTML = parseMD(document.getElementById('bodyInput').value);
    btn.textContent = '编辑';
  } else {
    body.style.display = '';
    preview.style.display = 'none';
    btn.textContent = '预览';
  }
}
function parseMD(text) {
  return text
    .replace(/^### (.+)$/gm, '<h3>$1</h3>')
    .replace(/^## (.+)$/gm, '<h2>$1</h2>')
    .replace(/^# (.+)$/gm, '<h1>$1</h1>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    .replace(/^\- (.+)$/gm, '<li>$1</li>')
    .replace(/\n\n/g, '</p><p>')
    .replace(/^(?!<[hpl])/gm, '<p>')
    + '</p>';
}

// ===== 发布 =====
async function publish() {
  const title = document.getElementById('titleInput').value.trim();
  const body = document.getElementById('bodyInput').value.trim();
  if (!title || !body) { setStatus('标题和正文不能为空', 'err'); return; }

  const token = localStorage.getItem('gh_token');
  if (!token) { setStatus('请先设置 GitHub Token', 'err'); document.getElementById('tokenSetup').style.display='block'; return; }

  setStatus('发布中...', '');

  const now = new Date();
  const dateStr = now.toISOString().split('T')[0];
  const timeStr = now.toLocaleString('zh-CN', { hour12: false });
  const slug = dateStr + '-' + title.replace(/[^\w一-鿿]/g, '-').replace(/-+/g,'-').replace(/^-|-$/g,'').substring(0,40).toLowerCase();

  const frontmatter = `---\ntitle: "${title}"\ndate: "${dateStr}"\ndesc: "${body.replace(/[#*\n]/g,' ').substring(0,80)}"\n---\n\n> 发布于 ${timeStr}\n\n${body}`;

  const path = `src/content/blog/${slug}.md`;
  const content = btoa(unescape(encodeURIComponent(frontmatter)));

  try {
    // Get latest commit SHA for main
    const mainRes = await fetch('https://api.github.com/repos/yihongma5/personal-site/git/refs/heads/main', {
      headers: { Authorization: `token ${token}` }
    });
    if (!mainRes.ok) throw new Error('API 请求失败，检查 Token 是否有效');
    const mainData = await mainRes.json();
    const baseSha = mainData.object.sha;

    // Create blob
    const blobRes = await fetch('https://api.github.com/repos/yihongma5/personal-site/git/blobs', {
      method: 'POST', headers: { Authorization: `token ${token}`, 'Content-Type':'application/json' },
      body: JSON.stringify({ content, encoding:'base64' })
    });
    const blobData = await blobRes.json();

    // Create tree
    const treeRes = await fetch('https://api.github.com/repos/yihongma5/personal-site/git/trees', {
      method: 'POST', headers: { Authorization: `token ${token}`, 'Content-Type':'application/json' },
      body: JSON.stringify({ base_tree: baseSha, tree: [{ path, mode:'100644', type:'blob', sha: blobData.sha }] })
    });
    const treeData = await treeRes.json();

    // Create commit
    const commitRes = await fetch('https://api.github.com/repos/yihongma5/personal-site/git/commits', {
      method: 'POST', headers: { Authorization: `token ${token}`, 'Content-Type':'application/json' },
      body: JSON.stringify({
        message: `blog: ${title}`,
        tree: treeData.sha,
        parents: [baseSha]
      })
    });
    const commitData = await commitRes.json();

    // Update ref
    await fetch(`https://api.github.com/repos/yihongma5/personal-site/git/refs/heads/main`, {
      method: 'PATCH', headers: { Authorization: `token ${token}`, 'Content-Type':'application/json' },
      body: JSON.stringify({ sha: commitData.sha, force: false })
    });

    setStatus('已发布！约 1 分钟后在日志页可见', 'ok');
    localStorage.removeItem('blog_draft');
    document.getElementById('titleInput').value = '';
    document.getElementById('bodyInput').value = '';
  } catch(e) {
    setStatus('发布失败: ' + e.message, 'err');
  }
}

function setStatus(msg, cls) {
  const el = document.getElementById('statusMsg');
  el.textContent = msg; el.className = 'status ' + cls;
}
</script>
</body>
</html>
