---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = "/personal-site/";

const projects = [
  {
    title: "淘客业务内部培训 —— 淘宝客扫盲",
    tags: ["淘客", "培训", "新人课程"],
    desc: "欧莱雅集团内部淘客新人培训资料，涵盖淘宝客基础概念、渠道运作逻辑、团长合作模式、常见术语与实操指南。面向推广团队及跨部门同事，统一集团淘客业务认知基线。",
    pdf: `${base}taoke-training.pdf`,
  },
  {
    title: "示例作品 2",
    tags: ["跨境电商", "香水"],
    desc: "香水打版项目，从选品到供应链的全流程。",
    pdf: "",
  },
  {
    title: "示例作品 3",
    tags: ["AI 提效", "自动化"],
    desc: "用 Claude Code 搭建的自动化工作流，提效 X 倍。",
    pdf: "",
  },
];
---

<BaseLayout title="作品 · Matt">
  <section style="padding:20px 0 40px;position:relative;">
    <div class="hero-num" style="position:absolute;top:-40px;right:0;">03</div>
    <p style="font-family:var(--serif);font-size:14px;color:var(--accent);letter-spacing:0.08em;margin-bottom:12px;">Portfolio</p>
    <h1 style="font-family:var(--serif);font-size:44px;font-weight:900;line-height:1.2;margin-bottom:12px;">作品与项目</h1>
    <p style="color:var(--text-muted);font-size:16px;">内容创作案例、电商项目与 AI 自动化工具</p>
  </section>

  <div>
    {projects.map((p) => (
      p.pdf ? (
        <a href={p.pdf} target="_blank" rel="noopener" style="text-decoration:none;color:inherit;">
          <div class="card">
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
            <div style="margin-top:12px;display:flex;align-items:center;justify-content:space-between;">
              <div>{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
              <span style="font-family:var(--serif);font-size:12px;color:var(--accent);">📄 点击查看 PDF →</span>
            </div>
          </div>
        </a>
      ) : (
        <div class="card">
          <h3>{p.title}</h3>
          <p>{p.desc}</p>
          <div style="margin-top:12px;">
            {p.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </div>
      )
    ))}
  </div>
</BaseLayout>
