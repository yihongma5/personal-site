---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = "/personal-site/";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const { slug } = Astro.params;
const posts = await getCollection("blog");
const post = posts.find((p) => p.id === slug);
if (!post) return Astro.redirect(`${base}blog`);
const { Content } = await post.render();
---

<BaseLayout title={`${post.data.title} · Matt`}>
  <article style="max-width:680px;margin:0 auto;">
    <p style="font-family:var(--serif);font-size:13px;color:var(--accent);letter-spacing:0.08em;margin-bottom:8px;">{post.data.date}</p>
    <h1 style="font-family:var(--serif);font-size:36px;font-weight:900;line-height:1.25;margin-bottom:32px;">{post.data.title}</h1>

    <div style="line-height:2;font-size:16px;color:var(--text-muted);">
      <Content />
    </div>

    <a href={`${base}blog`} style="display:inline-block;margin-top:48px;font-family:var(--serif);font-size:13px;color:var(--accent);text-decoration:none;letter-spacing:0.04em;">← 返回日志</a>
  </article>
</BaseLayout>
