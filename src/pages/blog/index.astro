---
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = "/personal-site/";

const posts = [
  { title: "示例博文：第一篇文章", date: "2026-05-30", slug: "first-post", desc: "这是你的第一篇日志。" },
];
---

<BaseLayout title="日志 · Matt">
  <section style="padding:20px 0 40px;position:relative;">
    <div class="hero-num" style="position:absolute;top:-40px;right:0;">05</div>
    <p style="font-family:var(--serif);font-size:14px;color:var(--accent);letter-spacing:0.08em;margin-bottom:12px;">Journal</p>
    <h1 style="font-family:var(--serif);font-size:44px;font-weight:900;line-height:1.2;margin-bottom:12px;">日志</h1>
    <p style="color:var(--text-muted);font-size:16px;">思考、复盘与日常记录</p>
  </section>

  {posts.map((post) => (
    <a href={`${base}blog/${post.slug}`} style="text-decoration:none;color:inherit;">
      <div class="card">
        <p style="font-family:var(--serif);font-size:11px;color:var(--accent);letter-spacing:0.08em;margin-bottom:6px;">{post.date}</p>
        <h3>{post.title}</h3>
        <p>{post.desc}</p>
      </div>
    </a>
  ))}
</BaseLayout>
